# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend.
# GEMINI_API_KEY cần thiết để chatbot hỏi đáp trên trang chủ trả lời thật; các biến còn lại
# dùng cho Tuần 3 (Supabase) và Tuần 6 (magic link) trở đi.

# Gemini API (chatbot hỏi đáp trên trang chủ)
GEMINI_API_KEY=

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
